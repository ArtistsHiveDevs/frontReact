{
  "name": "artists-hive",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host",
    "dev:host:remote": "vite --host --mode remote",
    "build": "tsc && vite build",
    "build-hs": "set NODE_OPTIONS=--max-old-space-size=8192 && npm run build",
    "build-ah": "tsc && vite build --base=/artistsHive/",
    "preview": "vite preview",
    "create-robots": "node scripts/deployment/createRobots.js",
    "deploy": "npm run build && npm run upload",
    "upload": "ts-node-esm ./deployment/ftp-upload.ts",
    "build:android": "npm run build && npx cap sync android"
  },
